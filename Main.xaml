<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinClicker" Width="448" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI" FontSize="13" Foreground="#CDD6F4">
  <Window.Resources>
    <SolidColorBrush x:Key="Fg" Color="#CDD6F4"/>
    <LinearGradientBrush x:Key="Accent" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#CBA6F7" Offset="0"/>
      <GradientStop Color="#89B4FA" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="StopBrush" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#F38BA8" Offset="0"/>
      <GradientStop Color="#FAB387" Offset="1"/>
    </LinearGradientBrush>

    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="#181825"/>
      <Setter Property="BorderBrush" Value="#313244"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="14"/>
    </Style>
    <Style x:Key="Head" TargetType="TextBlock">
      <Setter Property="FontSize" Value="10.5"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="#6C7086"/>
      <Setter Property="Margin" Value="4,14,0,7"/>
    </Style>
    <Style x:Key="Muted" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#A6ADC8"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="SegBox" TargetType="Border">
      <Setter Property="Background" Value="#11111B"/>
      <Setter Property="BorderBrush" Value="#313244"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="3"/>
    </Style>

    <Style x:Key="Input" TargetType="TextBox">
      <Setter Property="Foreground" Value="#CDD6F4"/>
      <Setter Property="CaretBrush" Value="#CDD6F4"/>
      <Setter Property="SelectionBrush" Value="#CBA6F7"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="b" Background="#11111B" BorderBrush="#45475A" BorderThickness="1" CornerRadius="9" Padding="9,0">
              <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="#6C7086"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="#CBA6F7"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Seg" TargetType="RadioButton">
      <Setter Property="Foreground" Value="#A6ADC8"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="b" Background="Transparent" CornerRadius="7" Height="28">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="#CDD6F4"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="b" Property="Background" Value="#45475A"/>
                <Setter Property="Foreground" Value="#CDD6F4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Foreground" Value="#CDD6F4"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Background="Transparent">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <ContentPresenter VerticalAlignment="Center"/>
              <Border x:Name="track" Grid.Column="1" Width="40" Height="22" CornerRadius="11" Background="#45475A">
                <Ellipse x:Name="thumb" Width="16" Height="16" Fill="#A6ADC8" HorizontalAlignment="Left" Margin="3,0"/>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="track" Property="Background" Value="{StaticResource Accent}"/>
                <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right"/>
                <Setter TargetName="thumb" Property="Fill" Value="#11111B"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Primary" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="13" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Opacity" Value="0.9"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="b" Property="Opacity" Value="0.75"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Ghost" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Foreground" Value="#CDD6F4"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="9" Background="#313244" BorderBrush="#313244" BorderThickness="1" Padding="12,0">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#45475A"/>
                <Setter TargetName="b" Property="BorderBrush" Value="#6C7086"/>
              </Trigger>
              <Trigger Property="Tag" Value="rec">
                <Setter TargetName="b" Property="BorderBrush" Value="#CBA6F7"/>
                <Setter TargetName="b" Property="Background" Value="#313244"/>
                <Setter Property="Foreground" Value="#B4BEFE"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="TitleBtn" TargetType="Button">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Width" Value="32"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="8" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#313244"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid x:Name="Root" Margin="16">
    <Border CornerRadius="18" Background="#1E1E2E">
      <Border.Effect>
        <DropShadowEffect BlurRadius="24" ShadowDepth="5" Direction="270" Opacity="0.55" Color="#000000"/>
      </Border.Effect>
    </Border>
    <Border CornerRadius="18" Background="#1E1E2E" BorderBrush="#313244" BorderThickness="1">
      <StackPanel Margin="18,12,18,16">

        <!-- title bar -->
        <Grid x:Name="TitleBar" Background="Transparent" Height="34">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="26" Height="26" CornerRadius="8" Background="{StaticResource Accent}">
              <Path Data="M0,0 L0,14 L4,10.5 L6.5,16 L8.5,15 L6,9.8 L11,9.8 Z" Fill="#11111B"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0"/>
            </Border>
            <TextBlock Text="WinClicker" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button x:Name="MinBtn" Style="{StaticResource TitleBtn}" ToolTip="Minimizar">
              <Path Data="M0,0 H10" Stroke="#A6ADC8" StrokeThickness="1.4"/>
            </Button>
            <Button x:Name="CloseBtn" Style="{StaticResource TitleBtn}" ToolTip="Fechar">
              <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="#A6ADC8" StrokeThickness="1.4"/>
            </Button>
          </StackPanel>
        </Grid>

        <!-- status -->
        <Border Style="{StaticResource Card}" Margin="0,10,0,0" Padding="18,14">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#585B70" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusText" Text="PRONTO" Margin="7,0,0,0" FontSize="10.5" FontWeight="Bold" Foreground="#A6ADC8"/>
              </StackPanel>
              <TextBlock x:Name="CountText" Text="0" FontSize="34" FontWeight="Bold" Margin="0,2,0,0"/>
              <TextBlock x:Name="SubText" Text="cliques nesta execução" Foreground="#A6ADC8" FontSize="12"/>
            </StackPanel>
            <Button x:Name="MainBtn" Grid.Column="1" Style="{StaticResource Primary}" Background="{StaticResource Accent}"
                    Width="128" Height="56" VerticalAlignment="Center">
              <StackPanel>
                <TextBlock x:Name="MainBtnText" Text="Iniciar" FontSize="16" FontWeight="Bold" Foreground="#11111B" HorizontalAlignment="Center"/>
                <TextBlock x:Name="MainBtnHint" Text="F6" FontSize="11" Foreground="#11111B" Opacity="0.8" HorizontalAlignment="Center"/>
              </StackPanel>
            </Button>
          </Grid>
        </Border>

        <StackPanel x:Name="SettingsPanel">
          <!-- target -->
          <TextBlock Text="ALVO" Style="{StaticResource Head}"/>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <Border Style="{StaticResource SegBox}">
                <UniformGrid Rows="1">
                  <RadioButton x:Name="ModeFixed" GroupName="mode" Style="{StaticResource Seg}" Content="Local fixo" IsChecked="True"/>
                  <RadioButton x:Name="ModeCursor" GroupName="mode" Style="{StaticResource Seg}" Content="Seguir o cursor"/>
                  <RadioButton x:Name="ModeWindow" GroupName="mode" Style="{StaticResource Seg}" Content="Numa janela"/>
                </UniformGrid>
              </Border>
              <Grid Margin="0,10,0,0" MinHeight="34">
                <Grid x:Name="FixedPanel" Height="34">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="X" Style="{StaticResource Muted}" FontWeight="SemiBold" Margin="2,0,8,0"/>
                  <TextBox x:Name="XBox" Grid.Column="1" Style="{StaticResource Input}"/>
                  <TextBlock Text="Y" Grid.Column="2" Style="{StaticResource Muted}" FontWeight="SemiBold" Margin="12,0,8,0"/>
                  <TextBox x:Name="YBox" Grid.Column="3" Style="{StaticResource Input}"/>
                  <Button x:Name="PickBtn" Grid.Column="4" Style="{StaticResource Ghost}" Margin="12,0,0,0">
                    <StackPanel Orientation="Horizontal">
                      <Grid Width="14" Height="14" VerticalAlignment="Center">
                        <Ellipse Stroke="#B4BEFE" StrokeThickness="1.4" Margin="2.5"/>
                        <Path Data="M7,0 V4 M7,10 V14 M0,7 H4 M10,7 H14" Stroke="#B4BEFE" StrokeThickness="1.4"/>
                      </Grid>
                      <TextBlock Text="Escolher na tela" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Button>
                </Grid>
                <TextBlock x:Name="CursorNote" Visibility="Collapsed" Style="{StaticResource Muted}" Margin="2,0,0,0" Height="34"
                           Text="Clica onde o seu ponteiro estiver no momento."/>
                <StackPanel x:Name="WindowPanel" Visibility="Collapsed">
                  <Grid Height="34">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="#11111B" BorderBrush="#45475A" BorderThickness="1" CornerRadius="9" Padding="10,0">
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="WindowDot" Width="8" Height="8" CornerRadius="4" Background="#585B70" VerticalAlignment="Center"/>
                        <TextBlock x:Name="WindowName" Text="Nenhuma janela escolhida" Margin="8,0,0,0" FontWeight="SemiBold"
                                   Foreground="#A6ADC8" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        <TextBlock x:Name="WindowPos" Margin="8,0,0,0" Foreground="#6C7086" VerticalAlignment="Center"/>
                      </StackPanel>
                    </Border>
                    <Button x:Name="PickWinBtn" Grid.Column="1" Style="{StaticResource Ghost}" Margin="12,0,0,0">
                      <StackPanel Orientation="Horizontal">
                        <Grid Width="14" Height="14" VerticalAlignment="Center">
                          <Ellipse Stroke="#B4BEFE" StrokeThickness="1.4" Margin="2.5"/>
                          <Path Data="M7,0 V4 M7,10 V14 M0,7 H4 M10,7 H14" Stroke="#B4BEFE" StrokeThickness="1.4"/>
                        </Grid>
                        <TextBlock Text="Escolher na tela" Margin="8,0,0,0" VerticalAlignment="Center"/>
                      </StackPanel>
                    </Button>
                  </Grid>
                  <TextBlock Foreground="#6C7086" FontSize="11.5" Margin="2,8,0,0" TextWrapping="Wrap"
                             Text="Os cliques são enviados direto para essa janela, então o seu mouse fica livre e você pode usar outros aplicativos enquanto isso. A janela pode ficar atrás das outras, mas não pode ser minimizada. Neste modo, apenas o atalho de parar interrompe."/>
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>

          <!-- click -->
          <TextBlock Text="CLIQUE" Style="{StaticResource Head}"/>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="96"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Intervalo entre cliques" VerticalAlignment="Center" Margin="2,0,0,0"/>
                <TextBox x:Name="IntervalBox" Grid.Column="1" Style="{StaticResource Input}" Text="100" TextAlignment="Right"/>
                <TextBlock Text="ms" Grid.Column="2" Style="{StaticResource Muted}" Margin="8,0,2,0"/>
              </Grid>
              <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="3*"/>
                  <ColumnDefinition Width="10"/>
                  <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource SegBox}">
                  <UniformGrid Rows="1">
                    <RadioButton x:Name="BtnLeft" GroupName="btn" Style="{StaticResource Seg}" Content="Esquerdo" IsChecked="True"/>
                    <RadioButton x:Name="BtnRight" GroupName="btn" Style="{StaticResource Seg}" Content="Direito"/>
                    <RadioButton x:Name="BtnMiddle" GroupName="btn" Style="{StaticResource Seg}" Content="Meio"/>
                  </UniformGrid>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource SegBox}">
                  <UniformGrid Rows="1">
                    <RadioButton x:Name="TypeSingle" GroupName="type" Style="{StaticResource Seg}" Content="Simples" IsChecked="True"/>
                    <RadioButton x:Name="TypeDouble" GroupName="type" Style="{StaticResource Seg}" Content="Duplo"/>
                  </UniformGrid>
                </Border>
              </Grid>
            </StackPanel>
          </Border>

          <!-- hotkeys -->
          <TextBlock Text="ATALHOS" Style="{StaticResource Head}"/>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Iniciar" Style="{StaticResource Muted}" Margin="2,0,10,0"/>
                <Button x:Name="StartKeyBtn" Grid.Column="1" Style="{StaticResource Ghost}" Content="F6" ToolTip="Clique e depois pressione o novo atalho"/>
                <TextBlock Text="Parar" Grid.Column="2" Style="{StaticResource Muted}" Margin="14,0,10,0"/>
                <Button x:Name="StopKeyBtn" Grid.Column="3" Style="{StaticResource Ghost}" Content="F7" ToolTip="Clique e depois pressione o novo atalho"/>
              </Grid>
              <CheckBox x:Name="AnyKey" Style="{StaticResource Switch}" Margin="2,12,2,0" IsChecked="True">
                <StackPanel>
                  <TextBlock Text="Parar com qualquer tecla"/>
                  <TextBlock x:Name="AnyKeyNote" Text="Desligado = só o atalho de parar interrompe" Foreground="#A6ADC8" FontSize="11.5"/>
                </StackPanel>
              </CheckBox>
            </StackPanel>
          </Border>
        </StackPanel>

        <TextBlock x:Name="FooterNote" Text="Mexer o mouse nunca interrompe — só o teclado interrompe."
                   Foreground="#6C7086" FontSize="11.5" HorizontalAlignment="Center" Margin="0,12,0,0"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
